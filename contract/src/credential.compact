pragma language_version >= 0.23;

import CompactStandardLibrary;

// ─── Credential state on the blockchain ───────────────────────────────────────

// Status of each credential slot
export enum CredentialStatus {
  PENDING,
  ISSUED,
  VERIFIED
}

// A single academic credential commitment stored publicly on-chain
// The actual grade data NEVER appears here — only a cryptographic commitment
export ledger credentialCount: Counter;
export ledger credentialOwner: Map<Uint<32>, Bytes<32>>;
export ledger credentialCommitment: Map<Uint<32>, Bytes<32>>;
export ledger credentialStatus: Map<Uint<32>, CredentialStatus>;
export ledger credentialThreshold: Map<Uint<32>, Uint<8>>;
export ledger eligibilityResult: Map<Uint<32>, Boolean>;

constructor() {
  credentialCount.increment(0);
}

// ─── Witness: private data that never leaves the student's machine ──────────────

// The student's private grade data (CGPA * 10 to avoid decimals, e.g. 85 = 8.5/10)
witness privateGrade(): Uint<8>;

// The issuer's secret key for signing the credential
witness issuerSecretKey(): Bytes<32>;

// The student's local secret for identity
witness studentSecretKey(): Bytes<32>;

// ─── Helper: derive a public key from a secret (for access control) ────────────

export circuit derivePublicKey(sk: Bytes<32>, context: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "zkcred:pk:"), context, sk]);
}

// ─── Circuit 1: Issue a credential (called by university/issuer) ────────────────
//
// The issuer commits the student's grade on-chain as a hash commitment.
// The actual grade stays private — only the commitment is stored.
// The issuer proves they know the grade by signing it with their secret key.
//
export circuit issueCredential(
  studentAddress: Bytes<32>,
  threshold: Uint<8>
): Uint<32> {
  // Get the private grade via witness (stays off-chain)
  const grade = privateGrade();

  // Derive the issuer's public key to identify who issued this
  const issuerKey = issuerSecretKey();
  const issuerPubKey = derivePublicKey(issuerKey, pad(32, "issuer"));

  // Create a cryptographic commitment to the grade
  // This is stored on-chain — it proves the grade was recorded, but reveals nothing
  const commitment = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "zkcred:commit:"),
    studentAddress,
    grade as Field as Bytes<32>
  ]);

  // Get the next credential ID
  const credId = credentialCount as Uint<32>;
  credentialCount.increment(1);

  // Store public data on-chain
  credentialOwner.insert(credId, disclose(studentAddress));
  credentialCommitment.insert(credId, disclose(commitment));
  credentialStatus.insert(credId, disclose(CredentialStatus.ISSUED));
  credentialThreshold.insert(credId, disclose(threshold));
  eligibilityResult.insert(credId, disclose(false));

  return credId;
}

// ─── Circuit 2: Prove eligibility (called by student) ───────────────────────────
//
// The student proves their grade meets the threshold WITHOUT revealing the grade.
// The ZK proof verifies: "I know a grade G such that:
//   - hash(studentAddress, G) == stored commitment
//   - G >= threshold"
//
export circuit proveEligible(credentialId: Uint<32>): Boolean {
  // Read the public threshold from on-chain state
  const threshold = credentialThreshold.lookup(disclose(credentialId));

  // Get the private grade via witness (only the student knows this)
  const grade = privateGrade();

  // Get the student's address via witness
  const studentSk = studentSecretKey();
  const studentAddr = derivePublicKey(studentSk, pad(32, "student"));

  // Verify the commitment matches (proves the grade was legitimately issued)
  const expectedCommitment = persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "zkcred:commit:"),
    studentAddr,
    grade as Field as Bytes<32>
  ]);

  const storedCommitment = credentialCommitment.lookup(disclose(credentialId));
  assert(
    expectedCommitment == storedCommitment,
    "Grade commitment does not match — credential may be invalid"
  );

  // Check eligibility: grade must meet the threshold
  // This assertion happens inside the ZK circuit — grade is NEVER disclosed
  assert(grade >= threshold, "Grade does not meet eligibility threshold");

  // Update eligibility result on-chain
  // Only discloses true/false — never the actual grade
  const result = true;
  eligibilityResult.insert(disclose(credentialId), disclose(result));
  credentialStatus.insert(disclose(credentialId), disclose(CredentialStatus.VERIFIED));

  return result;
}

// ─── Circuit 3: Read eligibility (called by verifier) ──────────────────────────
//
// Any verifier can call this to see the current eligibility result.
// It returns only PASS (true) or FAIL (false) — nothing about the actual grade.
//
export circuit checkEligibility(credentialId: Uint<32>): Boolean {
  const status = credentialStatus.lookup(disclose(credentialId));
  assert(
    status == CredentialStatus.VERIFIED,
    "Credential has not been verified yet"
  );
  return eligibilityResult.lookup(disclose(credentialId));
}
