{
  "name": "cygnus",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "contract",
    "api",
    "frontend",
    "cli"
  ],
  "scripts": {
    "setup": "npm install && npm run build:contract",
    "build:contract": "cd contract && npm run compact && npm run build",
    "dev:api": "cd api && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:cli": "cd cli && npm run local"
  }
}
